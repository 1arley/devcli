{
  "name": "@devcli/ui",
  "version": "0.0.0",
  "description": "Terminal UI components and utilities for Dev CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
