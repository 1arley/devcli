      "@devcli/plugin-git/*": ["../plugins/git/src/*"],
      "@devcli/plugin-jwt": ["../plugins/jwt/src"],
      "@devcli/plugin-jwt/*": ["../plugins/jwt/src/*"],
      "@devcli/plugin-json": ["../plugins/json/src"],
      "@devcli/plugin-json/*": ["../plugins/json/src/*"],
      "@devcli/plugin-uuid": ["../plugins/uuid/src"],
      "@devcli/plugin-uuid/*": ["../plugins/uuid/src/*"],
      "@devcli/plugin-qr": ["../plugins/qr/src"],
      "@devcli/plugin-qr/*": ["../plugins/qr/src/*"],
      "@devcli/plugin-env": ["../plugins/env/src"],
