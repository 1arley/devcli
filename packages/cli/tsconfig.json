{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@devcli/plugin-doctor": ["../plugins/doctor/src"],
      "@devcli/plugin-doctor/*": ["../plugins/doctor/src/*"],
      "@devcli/plugin-ports": ["../plugins/ports/src"],
