      "@devcli/plugin-standup": ["../plugins/standup/src"],
      "@devcli/plugin-standup/*": ["../plugins/standup/src/*"],
      "@devcli/plugin-context": ["../plugins/context/src"],
      "@devcli/plugin-context/*": ["../plugins/context/src/*"],
      "@devcli/plugin-clean": ["../plugins/clean/src"],
      "@devcli/plugin-clean/*": ["../plugins/clean/src/*"],
