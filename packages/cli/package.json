{
  "name": "@1arley/devcli",
  "version": "1.2.7",
  "description": "Dev CLI — the Raycast of the Terminal for Developers",
  "type": "module",
  "license": "MIT",
  "author": "1arley",
  "homepage": "https://github.com/1arley/devcli",
  "repository": {
    "type": "git",
    "url": "https://github.com/1arley/devcli.git"
  },
  "bugs": {
    "url": "https://github.com/1arley/devcli/issues"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "terminal",
    "devtools"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dev": "dev.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@devcli/core": "workspace:*",
    "@devcli/config": "workspace:*",
    "@devcli/ui": "workspace:*",
    "@devcli/plugin-doctor": "workspace:*",
    "@devcli/plugin-ports": "workspace:*",
    "@devcli/plugin-docker": "workspace:*",
    "@devcli/plugin-git": "workspace:*",
    "@devcli/plugin-jwt": "workspace:*",
    "@devcli/plugin-json": "workspace:*",
    "@devcli/plugin-uuid": "workspace:*",
    "@devcli/plugin-qr": "workspace:*",
    "@devcli/plugin-env": "workspace:*",
    "@devcli/plugin-repo": "workspace:*",
    "@devcli/plugin-ai": "workspace:*",
    "@devcli/plugin-ssh": "workspace:*",
    "@devcli/plugin-logs": "workspace:*",
    "@devcli/plugin-plugin": "workspace:*",
    "@devcli/plugin-standup": "workspace:*",
    "@devcli/plugin-context": "workspace:*",
    "@devcli/plugin-clean": "workspace:*",
    "@devcli/plugin-completion": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "ora": "^8.1.0",
    "boxen": "^8.0.1",
    "log-symbols": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
